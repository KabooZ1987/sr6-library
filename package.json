{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --reporter=verbose",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:accessibility": "vitest run --config vitest.accessibility.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:accessibility && npm run test:performance && npm run test:e2e"
  },
  "dependencies": {
    "@nuxt/kit": "^3.21.1",
    "@nuxtjs/tailwindcss": "7.0.0-beta.0",
    "@primevue/forms": "^4.5.4",
    "@prisma/client": "6.9.0",
    "@types/formidable": "^3.4.6",
    "@vitejs/plugin-vue": "^6.0.4",
    "formidable": "^3.5.4",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "nuxt": "^3.21.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "sweetalert2": "11.14.2",
    "tailwindcss": "^4.1.18",
    "tailwindcss-primeui": "^0.6.1",
    "uuid": "^11.1.0",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@primevue/nuxt-module": "^4.5.4",
    "@types/bun": "^1.3.9",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.11.1",
    "playwright": "^1.58.2",
    "prisma": "6.9.0",
    "sass": "1.89.1",
    "vitest": "^3.2.4"
  }
}
